# Required: Cloudflare Realtime SFU app credentials.
# Create an app under Cloudflare Dashboard -> Realtime -> Serverless SFU.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=

# Recommended: Cloudflare Realtime TURN key credentials.
# Without these, the app falls back to Cloudflare STUN only; relay mode is unavailable.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Server binding. Keep 127.0.0.1 when using a local reverse proxy.
HOST=127.0.0.1
PORT=9876

# Public HTTPS origin used for canonical URLs and link previews.
# Set this in production, e.g. https://call.example.com
PUBLIC_URL=

# Runtime limits. Values shown are the application defaults.
MAX_PEERS=8
RECONNECT_GRACE_SECONDS=12
MAX_RECORDING_MB=4096
JOINS_PER_MINUTE=40
KNOCK_SECONDS=120
